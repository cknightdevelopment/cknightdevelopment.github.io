{
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i _css/main.css -o assets/css/main.css --minify",
    "watch:css": "tailwindcss -i _css/main.css -o assets/css/main.css --watch=always",
    "build": "npm run build:css && bundle exec jekyll build",
    "check:links": "bundle exec htmlproofer _site --disable-external",
    "dev": "trap 'kill 0' EXIT; npm run watch:css & bundle exec jekyll serve --livereload --drafts"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "tailwindcss": "^4.3.3"
  }
}
